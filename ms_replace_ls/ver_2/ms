#!/usr/bin/env python3
import os
import sys
import argparse
from datetime import datetime

# ANSI color codes
COLORS = {
    "reset": "\033[0m",
    "dir": "\033[94m",    # Blue
    "exe": "\033[92m",    # Green
    "link": "\033[96m",   # Cyan
    "other": "\033[0m",   # Default
    "zebra1": "\033[100m",  # Gray background for zebra rows
    "zebra2": "\033[49m",   # Reset background for zebra rows
}

def get_file_type(filepath):
    if os.path.isdir(filepath):
        return "dir"
    elif os.path.islink(filepath):
        return "link"
    elif os.path.isfile(filepath) and os.access(filepath, os.X_OK):
        return "exe"
    else:
        return "other"

def format_size(size, human_readable=False):
    if human_readable:
        if size < 1024:
            return f"{size} B"
        elif size < 1024 * 1024:
            return f"{size / 1024:.1f} KB"
        elif size < 1024 * 1024 * 1024:
            return f"{size / (1024 * 1024):.1f} MB"
        else:
            return f"{size / (1024 * 1024 * 1024):.1f} GB"
    else:
        return f"{size} B"

def list_files(path=".", show_hidden=False, long_format=False, zebra=False, human_readable=False, sort_by="name"):
    try:
        files = os.listdir(path)
    except PermissionError:
        print(f"Permission denied: {path}", file=sys.stderr)
        return

    if not show_hidden:
        files = [f for f in files if not f.startswith('.')]

    # Sort files
    if sort_by == "type":
        files.sort(key=lambda f: get_file_type(os.path.join(path, f)))
    elif sort_by == "date":
        files.sort(key=lambda f: os.path.getmtime(os.path.join(path, f)))
    else:  # Default: sort by name
        files.sort()

    if human_readable:
        # First row: filenames
        for file in files:
            filepath = os.path.join(path, file)
            file_type = get_file_type(filepath)
            color = COLORS[file_type]
            print(f"{color}{file:<20}{COLORS['reset']}", end="  ")
        print()
        # Second row: sizes
        for file in files:
            filepath = os.path.join(path, file)
            size = os.path.getsize(filepath)
            print(f"{format_size(size, human_readable):<20}", end="  ")
        print()
    elif long_format:
        for i, file in enumerate(files):
            filepath = os.path.join(path, file)
            stat = os.stat(filepath)
            file_type = get_file_type(filepath)
            color = COLORS[file_type]
            size = stat.st_size
            size_str = format_size(size, zebra)  # Use human-readable if zebra is True
            mtime = datetime.fromtimestamp(stat.st_mtime).strftime('%b %d %H:%M')
            perms = oct(stat.st_mode)[-3:]
            zebra_bg = COLORS["zebra1"] if zebra and i % 2 == 0 else COLORS["zebra2"]
            print(
                f"{zebra_bg}{perms} {color}{file:<20}{COLORS['reset']} "
                f"{size_str:>10} {mtime}{COLORS['reset']}"
            )
    else:
        for file in files:
            filepath = os.path.join(path, file)
            file_type = get_file_type(filepath)
            color = COLORS[file_type]
            print(f"{color}{file}{COLORS['reset']}", end="  ")
        print()

def tree_view(path=".", show_hidden=False, folders_only=False, metadata=False, prefix=""):
    try:
        files = os.listdir(path)
    except PermissionError:
        print(f"Permission denied: {path}", file=sys.stderr)
        return

    if not show_hidden:
        files = [f for f in files if not f.startswith('.')]

    for i, file in enumerate(sorted(files)):
        filepath = os.path.join(path, file)
        stat = os.stat(filepath)
        file_type = get_file_type(filepath)
        color = COLORS[file_type]

        if folders_only and not os.path.isdir(filepath):
            continue

        if i == len(files) - 1:
            if metadata:
                size = format_size(stat.st_size, human_readable=True)
                mtime = datetime.fromtimestamp(stat.st_mtime).strftime('%b %d %H:%M')
                print(f"{prefix}└── {color}{file}{COLORS['reset']} ({size}, {mtime})")
            else:
                print(f"{prefix}└── {color}{file}{COLORS['reset']}")
            new_prefix = prefix + "    "
        else:
            if metadata:
                size = format_size(stat.st_size, human_readable=True)
                mtime = datetime.fromtimestamp(stat.st_mtime).strftime('%b %d %H:%M')
                print(f"{prefix}├── {color}{file}{COLORS['reset']} ({size}, {mtime})")
            else:
                print(f"{prefix}├── {color}{file}{COLORS['reset']}")
            new_prefix = prefix + "│   "

        if os.path.isdir(filepath):
            tree_view(filepath, show_hidden, folders_only, metadata, new_prefix)

def main():
    parser = argparse.ArgumentParser(description="Python-based 'ls' replacement with advanced features")
    parser.add_argument("-a", "--all", action="store_true", help="Show hidden files")
    parser.add_argument("-l", "--long", action="store_true", help="Long format (bytes)")
    parser.add_argument("-L", "--long-zebra", action="store_true", help="Long format with zebra rows (KB/MB/GB)")
    parser.add_argument("-H", "--human", action="store_true", help="Human-readable sizes in two rows (colorized)")
    parser.add_argument("-t", "--tree", action="store_true", help="Tree view (all files and folders)")
    parser.add_argument("-T", "--tree-folders", action="store_true", help="Tree view (folders only)")
    parser.add_argument("-M", "--tree-metadata", action="store_true", help="Tree view with metadata")
    parser.add_argument("--sort", choices=["name", "type", "date"], default="name", help="Sort by name, type, or date")
    parser.add_argument("path", nargs="?", default=".", help="Path to list")
    args = parser.parse_args()

    if args.tree:
        tree_view(args.path, args.all, folders_only=False, metadata=False)
    elif args.tree_folders:
        tree_view(args.path, args.all, folders_only=True, metadata=False)
    elif args.tree_metadata:
        tree_view(args.path, args.all, folders_only=False, metadata=True)
    else:
        list_files(args.path, args.all, args.long, args.long_zebra, args.human, args.sort)

if __name__ == "__main__":
    main()
